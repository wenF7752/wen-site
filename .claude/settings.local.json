{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/post-edit-lint.sh",
            "timeout": 30,
            "statusMessage": "Running linter on changed file..."
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "WebSearch"
    ]
  }
}
